{
  "name": "doc2md-electron",
  "version": "2.0.12",
  "description": "Doc to Markdown Converter - Cross-platform Electron version",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "node build-backend.js && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.doc2md.app",
    "productName": "DocToMarkdown",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build-backend.js"
    ],
    "extraResources": [
      {
        "from": "../python/dist/doc2md-backend",
        "to": "backend",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "icon": "app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "createDesktopShortcut": "always",
      "shortcutName": "Doc to Markdown",
      "installerIcon": "app-icon.ico",
      "uninstallerIcon": "app-icon.ico"
    },
    "mac": {
      "icon": "app-icon.icns",
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "icon": "app-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
